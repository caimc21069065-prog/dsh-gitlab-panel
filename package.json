{
  "name": "dsh-gitlab-panel",
  "version": "0.1.0",
  "description": "Git and GitLab for DeepSeek Harness: commit graph, branches, merge requests, reviews, pipelines, issues, triage and agent tools with an approval queue",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "gitlab",
    "git",
    "merge-requests",
    "issues",
    "code-review",
    "triage"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "mock": "node scripts/mock-gitlab.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
